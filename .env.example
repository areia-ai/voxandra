# Your Convex dev deployment. `npx convex dev` writes the first two into
# .env.local on first run; the site URL is the same name on .convex.site.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Convex Auth server environment. Set these on each Convex deployment
# with `npx convex env set ...`; do not expose them as NEXT_PUBLIC values.
# Use SITE_URL=https://voxandra.com in production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=http://localhost:3000
# Optional for branded OAuth. Set in Convex production to make Google show
# voxandra.com instead of the raw Convex site domain.
CUSTOM_AUTH_SITE_URL=

# Optional product analytics. Use the EU PostHog host for Voxandra.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Retired launch-interest export secret. Keep only while archived prelaunch
# mailing-list exports are still needed.
LAUNCH_INTEREST_CONVEX_SECRET=

# Transactional email delivery. Set these in Convex production env for
# workspace invites, onboarding, win-back, and call-record-ready emails.
RESEND_API_KEY=
EMAIL_FROM="Voxandra <hello@mail.voxandra.com>"
EMAIL_REPLY_TO=contact@voxandra.com

# Server-side only. Set this in the Convex deployment environment for Convex actions:
# npx convex env set OPENAI_API_KEY sk-...
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional. Defaults to OPENAI_MODEL/gpt-4o-mini for Ask records answers.
OPENAI_CALL_MEMORY_ASK_MODEL=gpt-4o-mini
# Optional. Defaults to text-embedding-3-small with 1536 dimensions for Call Records search.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional. Defaults to OPENAI_MODEL/gpt-4o-mini for shadow-agent predictions.
OPENAI_SHADOW_MODEL=gpt-4o-mini
# Optional. Set to false to skip shadow-agent predictions after transcription.
SHADOW_AGENT_ENABLED=true

# Optional. Defaults to gpt-4o-transcribe-diarize for multilingual speaker-aware transcripts.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Optional. Defaults to gpt-4o-transcribe,gpt-transcribe.
OPENAI_TRANSCRIPTION_FALLBACK_MODELS=gpt-4o-transcribe,gpt-transcribe

# Twilio browser calling. Placeholder values only; do not commit real secrets.
# NEXT_PUBLIC_TWILIO_CALLING_ENABLED, TWILIO_CALLER_ID,
# TWILIO_CONVEX_WEBHOOK_SECRET, TWILIO_ALLOWED_COUNTRIES/TWILIO_ALLOWED_NUMBERS,
# and TWILIO_MAX_CALL_SECONDS must also be set in Convex env because Convex
# validates outbound call eligibility and creates provider sessions.
# Refresh src/lib/twilio-rate-catalog.ts with npm run sync:twilio-rates before
# adding launch countries; destinations without provider-rate rows fail closed.
NEXT_PUBLIC_TWILIO_CALLING_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Optional override for Twilio Pricing API origin-sensitive rows. If blank,
# Voxandra quotes with the selected caller ID or TWILIO_CALLER_ID origin.
TWILIO_PRICING_ORIGIN_COUNTRY=
TWILIO_CONVEX_WEBHOOK_SECRET=
TWILIO_ALLOWED_COUNTRIES=AD,AE,AL,AR,AT,AU,BA,BE,BG,BH,BO,BR,CH,CL,CO,CR,CY,CZ,DE,DK,DO,EC,EE,ES,FI,FO,FR,GB,GI,GR,GT,HK,HN,HR,HU,ID,IE,IL,IN,IS,IT,JM,JP,KR,KW,LI,LT,LU,LV,MC,MD,ME,MK,MO,MT,MX,MY,NI,NL,NO,NZ,OM,PA,PE,PH,PL,PR,PT,PY,QA,RO,RS,SA,SE,SG,SI,SK,SM,SV,TH,TR,TT,TW,UA,US/CA,UY,VA,VN,XK,ZA
TWILIO_ALLOWED_NUMBERS=
# Optional stricter free-trial route controls. Leave blank to use the normal calling allowlist.
TWILIO_FREE_CALL_ALLOWED_COUNTRIES=
TWILIO_FREE_CALL_ALLOWED_NUMBERS=
TWILIO_MAX_CALL_SECONDS=600
# Optional operator ceiling for translated calls, applied before credit
# reservation and again as the callee leg's Twilio `timeLimit`. Workspaces
# default to 1800s, with owner options up to 3600s. This ceiling and any explicit
# TWILIO_MAX_CALL_SECONDS can only shorten that limit. Set in Convex env.
TWILIO_BRIDGE_MAX_CALL_SECONDS=
TWILIO_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_CALLER_ID_STATUS_CALLBACK_URL=
TWILIO_INBOUND_WEBHOOK_URL=
# Set in Convex env to allow rented-number inbound forwarding after live Twilio testing.
TWILIO_INBOUND_CALLING_ENABLED=false
TWILIO_NUMBER_SEARCH_COUNTRIES=US,CA
# Bridge media-path skeleton (internal-only, see AGENTIC_FUTURE.md): gates
# src/app/api/twilio/internal/echo-test/route.ts, which 404s unless this is
# "true". Point a spare/test Twilio number's voice webhook at this route to
# hear your own voice echoed back over a live <Connect><Stream> call.
TWILIO_ECHO_TEST_ENABLED=false
TWILIO_ECHO_TEST_WEBHOOK_URL=
# Must match a workspace ID on REALTIME_ECHO_TEST_WORKSPACE_IDS below AND on
# the worker's own env — both checks must independently agree.
TWILIO_ECHO_TEST_WORKSPACE_ID=
# Real two-leg translation bridge, sub-phase 5b (internal-only, real
# bidirectional Palabra translation, see AGENTIC_FUTURE.md /
# REALTIME_WORKER_RUNBOOK.md): gates
# src/app/api/twilio/internal/bridge/leg-twiml/route.ts, which 404s unless
# this is "true". A separate, categorically riskier gate from the echo-test
# skeleton above and from Live Audio Translation's listen-along mode — this
# one places a real, billed second Twilio call.
TWILIO_BRIDGE_MODE_ENABLED=false
TWILIO_BRIDGE_LEG_WEBHOOK_URL=
# Optional. Keep false in production unless temporarily debugging masked webhook state.
TWILIO_DEBUG_LOGS=false

# MCP server shared secret (/api/mcp). Set the SAME value in the Next.js env
# (Vercel) and in Convex env (`npx convex env set MCP_CONVEX_SECRET ...`).
# Server-side only; the MCP data surface fails closed when unset.
MCP_CONVEX_SECRET=

# Optional realtime media worker. Use a server-side WebSocket worker for
# premium Live Copilot and translated caption sessions; do not store raw audio.
REALTIME_MEDIA_STREAM_URL=
# Set this in Convex env and in the media worker so it can write usage events.
REALTIME_CONVEX_WORKER_SECRET=
# Set the SAME value in the Next.js env (Vercel) and in the media worker — NOT
# in Convex. The TwiML routes sign every Media Stream parameter set with it and
# the worker refuses any `start` that is unsigned, stale, or tampered (Twilio
# does not authenticate Media Stream connections itself). Deploy order when
# introducing or rotating it: Vercel first, then the worker.
REALTIME_STREAM_SIGNING_SECRET=
# Worker-only defaults for the separate realtime media worker.
REALTIME_WORKER_PORT=8787
REALTIME_WORKER_MAX_STREAMS=40
# Unauthenticated sockets are bounded per client address and by a start
# deadline so a flood cannot exhaust REALTIME_WORKER_MAX_STREAMS.
REALTIME_WORKER_MAX_PENDING_STREAMS_PER_IP=4
REALTIME_WORKER_STREAM_START_TIMEOUT_MS=5000
# Only when a proxy we control (Caddy on the VPS) sets X-Forwarded-For.
REALTIME_WORKER_TRUST_PROXY=true
# Local smoke scripts only. Never set on a deployed worker.
# REALTIME_ALLOW_UNSIGNED_STREAMS=true
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
OPENAI_LIVE_GUIDANCE_MODEL=gpt-realtime-2.1
REALTIME_LIVE_GUIDANCE_PIPELINE=audio_native
REALTIME_LIVE_GUIDANCE_REASONING_EFFORT=low
REALTIME_LIVE_GUIDANCE_MIN_INTERVAL_MS=1800
REALTIME_LIVE_GUIDANCE_SILENCE_MS=500
REALTIME_LIVE_GUIDANCE_MAX_TURN_MS=12000
# Cheapest GPT-5.6 text model for cascade Live Translation; upgrade to terra/sol
# if live quality review shows Luna is not enough.
OPENAI_LIVE_TRANSLATION_TEXT_MODEL=gpt-5.6-luna
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
# Keep direct as the global rollback path. Enable the transcription-first
# cascade only for comma-separated test workspace IDs until PSTN evals pass.
REALTIME_TRANSLATION_PIPELINE=direct
REALTIME_TRANSLATION_CASCADE_WORKSPACE_IDS=
# Spoken Translation Phase 1 (internal-only infra, see AGENTIC_FUTURE.md): the
# direct pipeline already receives session.output_audio.delta and has always
# discarded it. Set the same comma-separated workspace list here AND in Convex
# env (Convex and the worker are separate processes) to relay that audio to an
# allowlisted workspace's /browser/audio-stream connection. Empty by default;
# no customer-facing UI reads this yet.
REALTIME_TRANSLATION_AUDIO_FORWARD_WORKSPACE_IDS=
# Allowed browser Origin headers for /browser/audio-stream. Defaults to
# localhost dev origins when unset; set the real app origin(s) in production.
REALTIME_WORKER_BROWSER_AUDIO_STREAM_ORIGINS=
REALTIME_WORKER_MAX_BROWSER_AUDIO_STREAMS=20
# Worker-side ceiling for one translated-bridge leg's media session, in
# seconds (default 3600). The worker closes its own Twilio socket at this
# deadline, which ends a <Connect><Stream> leg — the failure-independent
# backstop if both Twilio's timeLimit and the Convex deadline job fail. Each
# leg is also handed a per-call `maxSessionSeconds` stream parameter, and this
# value clamps it: the parameter can only ever shorten the session.
REALTIME_BRIDGE_MAX_SESSION_SECONDS=3600
# Convex-side only (not read by the worker). Lets
# scripts/smoke-browser-audio-stream.mjs insert a synthetic call row on a
# dev/canary Convex deployment. Never set this on the production deployment.
ALLOW_BROWSER_AUDIO_STREAM_SMOKE_SEED=
# Real two-leg translation bridge, sub-phase 5b (internal-only, see
# AGENTIC_FUTURE.md). Convex-side only — the worker itself needs no matching
# copy; it only trusts the bridgeLeg param it's handed, which is only ever
# set once this allowlist check already passed upstream.
REALTIME_TRANSLATION_BRIDGE_WORKSPACE_IDS=
# Bridge media-path skeleton (internal-only, see AGENTIC_FUTURE.md): set the
# same comma-separated workspace list here AND on TWILIO_ECHO_TEST_WORKSPACE_ID
# above/in Convex env — every check must independently agree before the
# worker echoes audio back into a real call. No global on-switch by design.
REALTIME_ECHO_TEST_WORKSPACE_IDS=
# Spoken Translation Phase 3 (internal-only infra, see AGENTIC_FUTURE.md):
# workspaces on this list run Live Translation through Palabra's real-time
# speech-to-speech API (platform.palabra.ai) instead of the OpenAI direct/
# cascade pipelines — spoken translated audio plus captions from one vendor
# session. Allowlist only, no global on-switch. Worker-only; never set on the
# Next.js app.
REALTIME_TRANSLATION_PALABRA_WORKSPACE_IDS=
# Create at https://platform.palabra.ai/api-keys. Never commit this value —
# for local dev/probing, keep it in a gitignored file (e.g. palabra.rtf) and
# export it into the shell before running the worker/probe/smoke scripts.
PALABRA_API_KEY=
# Optional. A voice already created via Palabra's own Clone Voice API/
# dashboard (explicit sample upload, explicit consent, the account owner's
# own voice) — used in place of the generic "male" built-in voice, and only
# for the bridge's browser leg (the Voxandra user's own translated voice),
# never the callee's. Never commit a real value here for the same reason as
# PALABRA_API_KEY above.
PALABRA_CLONED_VOICE_ID=
# Legacy direct websocket endpoint. Only the probe's PALABRA_LEGACY_DIRECT_WS
# mode uses it now: the worker provisions one dedicated REST session per call
# leg (see PALABRA_SESSION_API_URL) because direct connections with the raw
# API key alias onto a single implicit account session — a second concurrent
# connection (e.g. the bridge's second leg) kills the first one's task.
PALABRA_TRANSLATION_URL=wss://streaming.palabra.ai/streaming-api/{random_hash}/v1/speech-to-speech/stream
# REST endpoint that creates a per-leg session (returns ws_url + publisher
# token). Override only for a non-default region/endpoint.
PALABRA_SESSION_API_URL=https://api.palabra.ai/session-storage/session
# 16 x 20ms Twilio frames per chunk = Palabra's documented ~320ms optimum.
REALTIME_PALABRA_CHUNK_FRAMES=16
# Bridge output mix. Each leg hears the other participant's ORIGINAL voice at
# this gain, with translated speech summed on top at full volume; the ducked
# gain applies while translated speech is actually playing. Translation-only
# output left dead silence during any lag, which testers found awkward.
REALTIME_BRIDGE_PASSTHROUGH_GAIN=0.3
REALTIME_BRIDGE_PASSTHROUGH_DUCKED_GAIN=0.06
# Translated speech is paced out one 20ms frame per inbound frame; a provider
# burst beyond this many ms drops its oldest audio rather than drifting behind.
REALTIME_BRIDGE_TRANSLATED_QUEUE_MAX_MS=4000
REALTIME_TRANSCRIPTION_SILENCE_MS=900
REALTIME_TRANSCRIPTION_MAX_UTTERANCE_MS=12000
REALTIME_TRANSCRIPTION_SPEECH_THRESHOLD=550
REALTIME_TRANSLATION_DRAIN_MS=5000
# How often partial translation captions flush to the UI. Lower is faster.
# Partials now update the same segment row in place, so the write rate is
# bounded to one row per utterance rather than one row per flush.
REALTIME_TRANSLATION_CAPTION_INTERVAL_MS=200
# Translation emits continuous transcript deltas rather than utterance-complete
# events. These worker-side boundaries keep each live caption line readable.
# Higher idle/max values produce fewer, fuller lines at a small end-of-utterance
# latency cost; lower values fragment long sentences into more captions.
REALTIME_TRANSLATION_SEGMENT_IDLE_MS=1600
REALTIME_TRANSLATION_SEGMENT_MAX_MS=15000
REALTIME_TRANSLATION_SEGMENT_MAX_CHARS=320
# Direct-path source/target pairing: source deltas beyond the target window
# plus this lead tolerance belong to the next caption.
REALTIME_TRANSLATION_SOURCE_LEAD_TOLERANCE_MS=1000
# Cascade text-translation calls abort after this long so one slow request
# never stalls the live caption pipeline.
REALTIME_TRANSLATION_REQUEST_TIMEOUT_MS=5000
# Minimum cascade transcription confidence (geometric-mean token probability)
# for an authoritative caption. 0 disables the gate; calibrate to >=95%
# precision on the Spanish canary set before enabling.
REALTIME_TRANSLATION_MIN_CONFIDENCE=0
# ~3 s of 20 ms Twilio frames retained in memory while provider sockets start.
REALTIME_PRE_READY_AUDIO_MAX_FRAMES=150

# Stripe billing. Use test-mode keys until launch verification is complete.
# STRIPE_CONVEX_WEBHOOK_SECRET must also be set in Convex env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONVEX_WEBHOOK_SECRET=
STRIPE_CHECKOUT_LOGO_FILE_ID=
STRIPE_NUMBER_RENTAL_LOOKUP_KEY=voxandra_calling_number_monthly
